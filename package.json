{
  "name": "modeloia-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop Windows build for ModeloIA",
  "author": "ModeloIA",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:prepare:frontend": "node electron/scripts/prepare-frontend.cjs",
    "desktop:prepare:backend": "node electron/scripts/build-backend.cjs",
    "desktop:prepare:ffmpeg": "node electron/scripts/prepare-ffmpeg.cjs",
    "desktop:prepare": "npm run desktop:prepare:frontend && npm run desktop:prepare:backend && npm run desktop:prepare:ffmpeg",
    "desktop:pack:dir": "npm run desktop:prepare && electron-builder --dir",
    "desktop:build": "npm run desktop:prepare && electron-builder --win nsis --publish never && node electron/scripts/copy-installer-to-root.cjs",
    "desktop:release": "npm run desktop:prepare && electron-builder --win nsis --publish always && node electron/scripts/copy-installer-to-root.cjs"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "next": "15.5.15"
  },
  "build": {
    "appId": "br.com.modeloia",
    "productName": "ModeloIA",
    "artifactName": "ModeloIA-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/main.cjs",
      "electron/recording-bridge.cjs",
      "electron/preload.cjs",
      "electron/updater.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/resources/backend",
        "to": "backend"
      },
      {
        "from": "electron/resources/frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/resources/frontend/node_modules",
        "to": "frontend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/resources/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "helberjf",
        "repo": "video-transcript",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
