# Desenvolvimento local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=troque-por-um-segredo-longo
DATABASE_URL=postgresql://postgres:senha@db.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:senha@db.supabase.co:5432/postgres
BACKEND_AUTH_SECRET=troque-por-um-segredo-compartilhado-com-o-backend

# Producao na Vercel: configure esta variavel no painel do projeto
# NEXT_PUBLIC_API_BASE_URL=https://api.seudominio.com/api

# Contas na web: emails do administrador (separados por virgula). O admin usa e configura a chave de IA
# global e pode liberar outras contas para usar essa chave em /admin/usuarios.
ADMIN_EMAILS=voce@email.com
# Opcional: workspace do admin. Use "pessoal" para continuar com os dados criados na web de senha unica.
ADMIN_WORKSPACE_ID=

# Login Google OAuth (opcional: sem estas variaveis o botao do Google nao aparece)
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
